// 这是模板。真正的 Sources/Secrets.swift 不进仓库（见 .gitignore），
// 由 GitHub Actions 在编译前用仓库 Secrets 自动生成。
// 本地想在 Mac 上编译时，可把本文件复制为 Secrets.swift 并填入真实值。
enum Secrets {
    static let amapKey        = "你的高德iOSKey"      // GitHub Secret: AMAP_IOS_KEY（Phase 1 必需）
    static let minimaxGroupId = "你的MiniMaxGroupId"  // GitHub Secret: MINIMAX_GROUP_ID（Phase 2）
    static let minimaxApiKey  = "你的MiniMaxApiKey"    // GitHub Secret: MINIMAX_API_KEY（Phase 2）
    static let minimaxVoiceId = "因的voice_id"         // GitHub Secret: MINIMAX_VOICE_ID（Phase 2）
}
