// 这是模板。真正的 Sources/Secrets.swift 不进仓库（见 .gitignore），
// 由 GitHub Actions 在编译前用仓库 Secrets 自动生成。
// 本地想在 Mac 上编译时，可把本文件复制为 Secrets.swift 并填入真实值。
enum Secrets {
    static let amapKey        = "你的高德iOSKey"      // GitHub Secret: AMAP_IOS_KEY
    static let minimaxGroupId = "你的MiniMaxGroupId"  // GitHub Secret: MINIMAX_GROUP_ID
    static let minimaxApiKey  = "你的MiniMaxApiKey"    // GitHub Secret: MINIMAX_API_KEY
    static let minimaxVoiceId = "因的voice_id"         // GitHub Secret: MINIMAX_VOICE_ID
    static let minimaxHost    = "https://api.minimaxi.com" // GitHub Secret: MINIMAX_HOST（跟 bot 一致）
    static let minimaxModel   = "speech-02-hd"        // GitHub Secret: MINIMAX_MODEL
    static let minimaxSpeed   = "1.0"                 // GitHub Secret: MINIMAX_SPEED
}
